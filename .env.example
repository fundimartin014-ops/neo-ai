LOG_LEVEL=INFO
LOG_JSON=true
API_AGENT_TOKEN=
API_AGENT_BASE_URL=
API_AGENT_TIMEOUT=10
FILE_AGENT_ROOT=./sandbox
WEB_TIMEOUT=10
SESSION_TIMEOUT=3600
DB_PATH=./data/agents.db

# ============ Cloud AI backends (all optional, all free-tier) ============
# HF_TOKEN — huggingface.co/join (free, no credit card)
#   Enables: HF Inference API for object detection (DETR, YOLOS, OWL-ViT)
# HF_TOKEN=

# REPLICATE_API_TOKEN — replicate.com/signin (free trial credits)
#   Enables: Prithvi-EO-2.0, Clay, Satlas satellite inference via cloud
# REPLICATE_API_TOKEN=

# GEMINI_API_KEY — aistudio.google.com/apikey (free tier, 15 req/min)
#   Enables: Gemini 2.0 Flash vision (object detection on any image)
# GEMINI_API_KEY=

# FRIGATE_URL — URL of a local or remote Frigate NVR (docker-compose in docs)
#   Enables: pulling camera events into the map automatically
# FRIGATE_URL=http://127.0.0.1:5000

# NEO_GEOSPATIAL_MODEL — only needed if you have a local GPU
#   Set to "prithvi-eo-2.0" to use a locally-installed Prithvi model
# NEO_GEOSPATIAL_MODEL=


# ============ Reasoning mode ============
# NEO_REASONING_MODE=verify
#
#   WARNING: multiplies LLM calls by 4-5x per query. Free-tier providers
#   (Groq ~30/min, OpenRouter 20/min) will rate-limit fast. Enable only
#   when you need the extra check.
#
#   Per-query override:
#       /fast <question>    -> single-call fast path
#       /verify <question>  -> force the verification loop
#
# NEO_REASONING_MODE=


# ============ Colab video backend ============
# Free text-to-video via Google Colab (Wan 2.1 Fast on an HF Space).
# See docs/COLAB_VIDEO.md for the 3-step setup.
# Paste the ngrok URL printed by the Colab notebook, then restart Neo.
# COLAB_VIDEO_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app


# Colab URL auto-discovery via ntfy.sh
# Set this to the SAME topic used in your Colab notebook cell 5.
# Every time you restart Colab, the new URL is picked up automatically.
# Leave COLAB_VIDEO_URL empty when using this.
# COLAB_NTFY_TOPIC=neo-colab-fundi-9k4m2x
